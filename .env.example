# Copiez ce fichier en .env.local (jamais versionné) et renseignez votre clé.
# Clé gratuite : https://aistudio.google.com/apikey

# Facultatif : fournisseur d’IA (server/ai/provider.mjs). Seule valeur disponible : gemini (par défaut).
AI_PROVIDER=

GEMINI_API_KEY=

# Facultatif : modèle Gemini utilisé (par défaut : gemini-flash-latest, le Flash le plus récent).
GEMINI_MODEL=

# Facultatif : modèle économe, au choix dans les paramètres et utilisé pour les titres
# (par défaut : gemini-flash-lite-latest ; quota gratuit distinct et plus large).
GEMINI_LITE_MODEL=

# Mot de passe de la console d’administration (/admin), 12 caractères au moins.
# Absent : la console reste fermée. À définir comme secret sur l’hébergement, jamais dans le dépôt.
ADMIN_PASSWORD=
